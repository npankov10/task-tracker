generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id    Int    @id @default(autoincrement())
  name  String
  tasks Task[]
}

model Task {
  id          Int     @id @default(autoincrement())
  title       String
  description String
  completed   Boolean @default(false)
  priority    String  @default("medium")
  project     Project @relation(fields: [projectId], references: [id])
  projectId   Int
}
